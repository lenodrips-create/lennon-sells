{
  "name": "lennonh-mac",
  "private": true,
  "description": "The 3D MacBook on lennonh.com, bundled with three.js into mac.min.js",
  "scripts": {
    "build": "esbuild src/paint.js --bundle --minify --format=iife --outfile=src/paint.worker.txt && esbuild src/mac.js --bundle --minify --format=esm --loader:.txt=text --outfile=mac.min.js"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "three": "0.180.0"
  }
}
